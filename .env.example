# Discord Bot Configuration
DISCORD_TOKEN=your_discord_bot_token_here
APPLICATION_ID=your_discord_application_id_here
BOT_OWNER_ID=your_discord_user_id_here

# Supabase Configuration
# SUPABASE_KEY must be the service_role (legacy) or secret (sb_secret_...) key.
# The bot refuses to start with the public anon/publishable key. Never commit or share it.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key_here

# Optional: Direct Database Access (for migrations/scripts)
# DATABASE_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require

# Error alerts (optional)
# Discord webhook that receives every ERROR log (rate limited, no pings).
# ERROR_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Health Check Configuration (optional)
# Use 0.0.0.0 when a container/orchestrator probes the bot from outside the host
HEALTH_CHECK_HOST=127.0.0.1
HEALTH_CHECK_PORT=8080
